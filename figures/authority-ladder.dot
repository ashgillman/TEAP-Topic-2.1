digraph authority_ladder {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad=0.25,
    nodesep=0.18,
    ranksep=0.42,
    splines=polyline,
    fontname="Helvetica",
    label="Authority ladder",
    labelloc=t,
    fontsize=18
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=11,
    margin="0.20,0.12",
    width=5.4,
    penwidth=1.5
  ];

  edge [
    color="#475569",
    fontcolor="#334155",
    fontname="Helvetica",
    fontsize=9,
    arrowsize=0.75,
    penwidth=1.3
  ];

  evidence [
    label="SCIENTIFIC EVIDENCE + PROFESSIONAL CONSENSUS\nRadiation effects, risk, dosimetry and workable controls\nTechnical basis — not law",
    fillcolor="#F1F5F9",
    color="#64748B"
  ];

  international [
    label="INTERNATIONAL RECOMMENDATIONS + SAFETY STANDARDS\nICRP 103 • IAEA SF-1 • GSR Part 3 • SSG-46\nInternational influence — no direct Queensland regulator",
    fillcolor="#E8F1FB",
    color="#2563EB",
    style="rounded,filled,dashed"
  ];

  australia [
    label="AUSTRALIAN FRAMEWORK\nRPS F-1 • NDRP2 • RPS C-1 • RPS C-5 • RPS 14.3\nNational code or guidance — force depends on adoption",
    fillcolor="#E6F7F5",
    color="#0F766E"
  ];

  queensland [
    label="QUEENSLAND LAW + STATUTORY STANDARDS\nRadiation Safety Act 1999 • Regulation 2021 • Premises Standard 2021\nBinding law; selected codes become licence conditions",
    fillcolor="#FFF1D6",
    color="#C2410C",
    penwidth=2.4
  ];

  rspp [
    label="APPROVED THHS RSPP\nRegulator-approved local plan identified in the possession licence\nSite hazards, responsibilities, controls and review",
    fillcolor="#F3E8FF",
    color="#7E22CE",
    penwidth=2.4
  ];

  procedure [
    label="DEPARTMENTAL PROCEDURE / WORK INSTRUCTION\nOperational steps, roles, tolerances and escalation\nControlled local implementation",
    fillcolor="#FFF7ED",
    color="#B45309"
  ];

  record [
    label="IMPLEMENTATION RECORD\nPrescription • authorisation • QA • monitoring • incident record\nEvidence that the control was performed",
    fillcolor="#ECFDF5",
    color="#15803D"
  ];

  evidence -> international [label="informs"];
  international -> australia [label="translated into national framework"];
  australia -> queensland [label="adopted / prescribed only where identified"];
  queensland -> rspp [label="requires, conditions and approves"];
  rspp -> procedure [label="operationalised by"];
  procedure -> record [label="evidenced by"];
}
